{
  "name": "moonglass",
  "version": "1.1.5",
  "description": "MoonGlass ASIC Design Agent — 芯片开发全流程 AI 工作台",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "author": {
    "name": "MoonGlass Contributors",
    "email": "moonglassagent@126.com"
  },
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "predist": "node scripts/stage-pi-runtime.mjs && node scripts/stage-aigv-runtime.mjs",
    "dist": "electron-builder",
    "dist:dir": "node scripts/stage-pi-runtime.mjs && node scripts/stage-aigv-runtime.mjs && electron-builder --win dir",
    "package:green": "node scripts/package-green.mjs",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "rebuild:node": "pnpm rebuild better-sqlite3",
    "typecheck": "pnpm -r typecheck",
    "typecheck:root": "tsc --noEmit -p tsconfig.json",
    "lint:rtl": "node scripts/rtl-design-lint.mjs",
    "smoke:ip-library": "node scripts/ip-library-service-smoke.mjs",
    "smoke:sram-generator": "node scripts/sram-generator-smoke.mjs",
    "smoke:project-import": "node scripts/project-import-analyzer-smoke.mjs",
    "smoke:axi-lite-timer": "node scripts/axi-lite-timer-smoke.mjs",
    "test": "node scripts/version-consistency-check.mjs && node scripts/check-skills.mjs && node scripts/run-tests.mjs core",
    "test:integration": "node scripts/run-tests.mjs integration",
    "stage:aigv-runtime": "node scripts/stage-aigv-runtime.mjs"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "electron": "^41.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "playwright-core": "^1.62.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@electron-toolkit/utils": "^4.0.0",
    "@monaco-editor/react": "^4.7.0",
    "@moonglass/design-browser-engine": "workspace:*",
    "@moonglass/eda-bridge": "workspace:*",
    "@moonglass/verification-intelligence-engine": "workspace:*",
    "@moonglass/prompts": "workspace:*",
    "@moonglass/rtl-engine": "workspace:*",
    "@tailwindcss/vite": "^4.1.0",
    "@tanstack/react-router": "^1.120.0",
    "better-sqlite3": "^12.0.0",
    "dompurify": "^3.4.13",
    "drizzle-orm": "^0.44.0",
    "lucide-react": "^1.28.0",
    "marked": "^18.0.9",
    "monaco-editor": "^0.56.0",
    "prismjs": "^1.30.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.0",
    "zustand": "^5.0.0"
  }
}
