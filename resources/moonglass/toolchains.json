{
  "toolchains": [
    {
      "id": "verilator-yosys",
      "name": "开源工具链 (Verilator + Yosys)",
      "simulator": {
        "type": "verilator",
        "path": "verilator"
      },
      "synthesis": {
        "type": "yosys",
        "path": "yosys",
        "libraries": [
          {
            "id": "nangate45-typical",
            "name": "Nangate45 Open Cell Library (Typical)",
            "process": "45nm",
            "path": "D:/Projects/rtl_lib/Library/OpenROAD-flow-scripts/flow/platforms/nangate45/lib/NangateOpenCellLibrary_typical.lib",
            "default": true
          }
        ]
      },
      "lint": {
        "type": "verible",
        "path": "verible-verilog-lint",
        "rules": "resources/moonglass/rules/verible_default_rules.txt"
      }
    },
    {
      "id": "synopsys-enterprise",
      "name": "Synopsys 企业工具链（占位）",
      "simulator": {
        "type": "vcs",
        "path": "/tools/synopsys/vcs/bin/vcs"
      },
      "synthesis": {
        "type": "dc",
        "path": "/tools/synopsys/dc/bin/dc_shell"
      }
    }
  ]
}
