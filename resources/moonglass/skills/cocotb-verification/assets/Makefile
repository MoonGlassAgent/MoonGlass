# Makefile for Cocotb Verification Environment
# Generated by Cocotb Verification Skill
# Date: {DATE}

#=============================================================
# Configuration
#=============================================================
# Simulator selection (icarus, verilator, modelsim, etc.)
SIM ?= icarus

# Top-level language
TOPLEVEL_LANG = verilog

# Source files
VERILOG_SOURCES = $(PWD)/rtl/{DUT_NAME}.v

# Top-level module name
TOPLEVEL = {DUT_NAME}

# Test module name (Python file without .py)
MODULE = {TEST_MODULE}

# Extra arguments for simulator
EXTRA_ARGS =

# Coverage options
COVERAGE ?= 0
ifeq ($(COVERAGE),1)
    EXTRA_ARGS += --coverage
endif

# Waveform options
WAVE ?= 0
ifeq ($(WAVE),1)
    EXTRA_ARGS += -DWAVEFORM
endif

# Verbose output
VERBOSE ?= 0
ifeq ($(VERBOSE),1)
    EXTRA_ARGS += -v
endif

#=============================================================
# Cocotb Makefile Include
#=============================================================
include $(shell cocotb-config --makefiles)/Makefile.sim

#=============================================================
# Custom Targets
#=============================================================

# Default target
all: help

# Run basic test
test-basic:
	$(MAKE) MODULE=test_basic SIM=$(SIM)

# Run all tests
test-all:
	$(MAKE) MODULE=test_regression SIM=$(SIM)

# Run with coverage
test-coverage:
	$(MAKE) MODULE=test_regression SIM=$(SIM) COVERAGE=1

# Run with waveform
test-wave:
	$(MAKE) MODULE=test_basic SIM=$(SIM) WAVE=1

# View waveform
view-wave:
	gtkwave dump.vcd

# Clean build files
clean::
	rm -rf results.xml
	rm -rf dump.vcd
	rm -rf *.log
	rm -rf __pycache__
	rm -rf *.pyc

# Deep clean
distclean: clean
	rm -rf sim_build

# Help
help:
	@echo "Cocotb Verification Environment"
	@echo "================================"
	@echo ""
	@echo "Usage:"
	@echo "  make                  - Show this help"
	@echo "  make test-basic       - Run basic test"
	@echo "  make test-all         - Run all tests"
	@echo "  make test-coverage    - Run with coverage"
	@echo "  make test-wave        - Run with waveform"
	@echo "  make view-wave        - View waveform in GTKWave"
	@echo "  make clean            - Clean build files"
	@echo ""
	@echo "Variables:"
	@echo "  SIM=icarus            - Use Icarus Verilog (default)"
	@echo "  SIM=verilator         - Use Verilator"
	@echo "  COVERAGE=1            - Enable coverage"
	@echo "  WAVE=1                - Enable waveform dump"
	@echo "  VERBOSE=1             - Verbose output"
	@echo ""
	@echo "Examples:"
	@echo "  make test-basic SIM=icarus"
	@echo "  make test-all SIM=verilator"
	@echo "  make test-coverage COVERAGE=1"

#=============================================================
# Icarus Verilog Specific
#=============================================================
ifeq ($(SIM),icarus)
    # Extra Icarus-specific options
    EXTRA_ARGS += -g2012
endif

#=============================================================
# Verilator Specific
#=============================================================
ifeq ($(SIM),verilator)
    # Extra Verilator-specific options
    EXTRA_ARGS += --trace --trace-structs
endif

#=============================================================
# Phony targets
#=============================================================
.PHONY: all test-basic test-all test-coverage test-wave view-wave clean distclean help